              "raw": "{\n  \"fullName\": \"Duplicate\",\n  \"email\": \"{{newEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
