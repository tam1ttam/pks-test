{
  "info": {
    "name": "PKS Full API Evidence",
    "description": "Run the folders from top to bottom against the local API. Postman keeps the client/admin HttpOnly cookies automatically. Open each request after running it to capture request, status, and response evidence.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3030/api" },
    { "key": "adminEmail", "value": "admin@pks.demo" },
    { "key": "adminPassword", "value": "PksDemo@123", "type": "secret" },
    { "key": "testPassword", "value": "PksTest@123456", "type": "secret" },
    { "key": "suffix", "value": "" },
    { "key": "studentEmail", "value": "" },
    { "key": "studentCode", "value": "" },
    { "key": "courseCode", "value": "" },
    { "key": "enrollmentCode", "value": "" }
  ],
  "event": [{
    "listen": "prerequest",
    "script": { "type": "text/javascript", "exec": [
      "if (!pm.collectionVariables.get('suffix')) {",
      "  const suffix = Date.now().toString();",
      "  pm.collectionVariables.set('suffix', suffix);",
      "  pm.collectionVariables.set('studentEmail', `postman-${suffix}@example.com`);",
      "}"
    ] }
  }],
  "item": [
    {
      "name": "01 - Health and public courses",
      "item": [
        {
          "name": "API health",
          "request": { "method": "GET", "url": "{{baseUrl}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Public course list",
          "request": { "method": "GET", "url": "{{baseUrl}}/courses?search=React&page=1&limit=20" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Paginated response', () => { const body = pm.response.json(); pm.expect(body.items).to.be.an('array'); pm.expect(body).to.have.keys('items','total','page','limit'); });"
          ] } }]
        }
      ]
    },
    {
      "name": "02 - Authentication evidence",
      "item": [
        {
          "name": "Register student - success",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Postman Student\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json(); pm.collectionVariables.set('studentCode', body.code);",
            "pm.test('No password fields', () => { pm.expect(body.code).to.match(/^USR-/); pm.expect(body).not.to.have.property('passwordHash'); pm.expect(body).not.to.have.property('password'); });"
          ] } }]
        },
        {
          "name": "Register duplicate email - 409",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Duplicate Student\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Duplicate is rejected with 409', () => pm.response.to.have.status(409));"] } }]
        },
        {
          "name": "Login wrong password - 401",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"wrong-password\",\n  \"portal\": \"CLIENT\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Wrong password is rejected with 401', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "Login student - success",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"portal\": \"CLIENT\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200 and STUDENT role', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().user.role).to.eql('STUDENT'); });"] } }]
        },
        {
          "name": "Current client session",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Client cookie restores session', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('studentEmail')); });"] } }]
        },
        {
          "name": "Login admin - separate cookie",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-PKS-Portal", "value": "admin" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"portal\": \"ADMIN\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200 and ADMIN role', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().user.role).to.eql('ADMIN'); });"] } }]
        },
        {
          "name": "Student cannot list admin users - 403",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/users" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Student is forbidden', () => pm.response.to.have.status(403));"] } }]
        }
      ]
    },
    {
      "name": "03 - Course CRUD as Admin",
      "item": [
        {
          "name": "Create course",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-PKS-Portal", "value": "admin" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Course {{suffix}}\",\n  \"category\": \"API Testing\",\n  \"instructor\": \"PKS Tester\",\n  \"shortDescription\": \"Course generated by Postman\",\n  \"description\": \"Temporary course used to verify CRUD and enrollment flows.\",\n  \"tuition\": 1000000,\n  \"capacity\": 1,\n  \"isPublished\": true\n}" },
            "url": "{{baseUrl}}/admin/courses"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json(); pm.collectionVariables.set('courseCode', body.code); pm.test('Public code returned', () => pm.expect(body.code).to.match(/^CRS-/));"
          ] } }]
        },
        {
          "name": "Update course",
          "request": {
            "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-PKS-Portal", "value": "admin" }],
            "body": { "mode": "raw", "raw": "{\n  \"tuition\": 1200000,\n  \"capacity\": 1\n}" },
            "url": "{{baseUrl}}/admin/courses/{{courseCode}}"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Course updated', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().tuition).to.eql(1200000); });"] } }]
        },
        {
          "name": "Invalid capacity - 400",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-PKS-Portal", "value": "admin" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Invalid Course\",\n  \"category\": \"Test\",\n  \"instructor\": \"Tester\",\n  \"shortDescription\": \"Invalid capacity\",\n  \"description\": \"Must be rejected by backend validation.\",\n  \"tuition\": 0,\n  \"capacity\": 0,\n  \"isPublished\": true\n}" },
            "url": "{{baseUrl}}/admin/courses"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Validation returns 400', () => pm.response.to.have.status(400));"] } }]
        }
      ]
    },
    {
      "name": "04 - Enrollment flow",
      "item": [
        {
          "name": "Student enrolls course",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"courseCode\": \"{{courseCode}}\"\n}" },
            "url": "{{baseUrl}}/enrollments"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json(); pm.collectionVariables.set('enrollmentCode', body.code); pm.test('Enrollment belongs to current student', () => pm.expect(body.studentCode).to.eql(pm.collectionVariables.get('studentCode')));"
          ] } }]
        },
        {
          "name": "Duplicate enrollment - 409",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"courseCode\": \"{{courseCode}}\"\n}" },
            "url": "{{baseUrl}}/enrollments"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Duplicate is rejected with 409', () => pm.response.to.have.status(409));"] } }]
        },
        {
          "name": "My courses",
          "request": { "method": "GET", "url": "{{baseUrl}}/enrollments/me?limit=100" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Only own enrollments are returned', () => { pm.response.to.have.status(200); const item = pm.response.json().items.find(x => x.code === pm.collectionVariables.get('enrollmentCode')); pm.expect(item.studentCode).to.eql(pm.collectionVariables.get('studentCode')); });"] } }]
        },
        {
          "name": "Admin views course roster",
          "request": { "method": "GET", "header": [{ "key": "X-PKS-Portal", "value": "admin" }], "url": "{{baseUrl}}/admin/courses/{{courseCode}}/enrollments?limit=100" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Roster contains required fields', () => { pm.response.to.have.status(200); const item=pm.response.json().items[0]; pm.expect(item.student).to.have.keys('code','fullName','email'); pm.expect(item).to.have.property('enrolledDate'); });"] } }]
        }
      ]
    },
    {
      "name": "05 - Cleanup",
      "item": [
        {
          "name": "Delete enrollment",
          "request": { "method": "DELETE", "header": [{ "key": "X-PKS-Portal", "value": "admin" }], "url": "{{baseUrl}}/enrollments/{{enrollmentCode}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 204', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "Delete course",
          "request": { "method": "DELETE", "header": [{ "key": "X-PKS-Portal", "value": "admin" }], "url": "{{baseUrl}}/admin/courses/{{courseCode}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 204', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "Delete test student",
          "request": { "method": "DELETE", "header": [{ "key": "X-PKS-Portal", "value": "admin" }], "url": "{{baseUrl}}/admin/users/{{studentCode}}" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 204', () => pm.response.to.have.status(204));",
            "pm.collectionVariables.set('suffix',''); pm.collectionVariables.set('studentEmail',''); pm.collectionVariables.set('studentCode',''); pm.collectionVariables.set('courseCode',''); pm.collectionVariables.set('enrollmentCode','');"
          ] } }]
        }
      ]
    }
  ]
}
